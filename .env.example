# Any OpenAI-compatible endpoint. Default: Google Gemini free tier (https://aistudio.google.com/apikey)
FINN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FINN_LLM_API_KEY=
# Model names change as providers retire versions. If a name below isn't served any more, FINN lists
# the models your key can use, picks the newest stable one, and tells you what to put here.
# `python -m finn doctor` shows which models are in use.
FINN_FAST_MODEL=gemini-3.5-flash-lite
FINN_SMART_MODEL=gemini-3.5-flash

# Groq example:
# FINN_LLM_BASE_URL=https://api.groq.com/openai/v1
# FINN_FAST_MODEL=llama-3.1-8b-instant
# FINN_SMART_MODEL=llama-3.3-70b-versatile

# Ollama (local, free):
# FINN_LLM_BASE_URL=http://localhost:11434/v1
# FINN_FAST_MODEL=qwen2.5:7b
# FINN_SMART_MODEL=qwen2.5:14b

# Optional cost display, USD per 1M tokens "input,output"
# FINN_PRICE_FAST=0.10,0.40
# FINN_PRICE_SMART=0.30,2.50

# Optional: web background for incoming executives (https://tavily.com, free tier)
FINN_SEARCH_API_KEY=
